{
  "framework": "vite",
  "installCommand": "npm ci --prefix aadesigns-main",
  "buildCommand": "npm run build --prefix aadesigns-main",
  "outputDirectory": "aadesigns-main/dist",
  "rewrites": [{ "source": "/((?!.*\\.).*)", "destination": "/index.html" }],
  "headers": [
    {
      "source": "/images/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    }
  ]
}
